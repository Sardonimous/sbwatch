<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <interface>
        <field id="launchArgs" type="assocarray" />
        <field id="go" type="boolean" alwaysNotify="true" onChange="startApp" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <script type="text/brightscript" uri="pkg:/components/Guide.brs" />
    <script type="text/brightscript" uri="pkg:/components/Search.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />

    <children>
        <Rectangle id="bg" width="1920" height="1080" color="0x0B0F14FF" />

        <Label id="title" text="SBWatch" translation="[60,40]" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
        <Label id="hint" translation="[60,1005]" width="1800" color="0x8A97A6FF"
               text="OK: select/play   *: favorite / change provider   Search: first row of categories   Replay: filter categories / full guide   Right: scroll guide panel   Watching: Up/Down channel, Left: guide, Replay: menu" />

        <LabelList id="catList" translation="[60,130]" itemSize="[520,56]" numRows="14"
                   vertFocusAnimationStyle="floatingFocus" color="0xC8D1DCFF" focusedColor="0xFFFFFFFF" />
        <MarkupList id="chList" translation="[620,130]" itemComponentName="ChannelItem" itemSize="[720,56]" numRows="14"
                    vertFocusAnimationStyle="floatingFocus" />

        <Rectangle id="panel" translation="[1380,130]" width="480" height="784" color="0x141B24FF" />
        <Rectangle id="panelAccent" translation="[1380,130]" width="480" height="4" color="0x2EA44FFF" />
        <Poster id="chLogo" translation="[1400,150]" width="64" height="36" visible="false" loadDisplayMode="scaleToFit" loadWidth="128" loadHeight="72" />
        <Label id="chName" translation="[1476,142]" width="364" height="64" wrap="true" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
        <Label id="epgText" translation="[1400,230]" width="440" height="200" wrap="true" font="font:SmallSystemFont" color="0xC8D1DCFF" />
        <MarkupList id="epgList" translation="[1390,215]" itemComponentName="EpgItem" itemSize="[460,154]" itemSpacing="[0,8]" numRows="4"
                    vertFocusAnimationStyle="floatingFocus" visible="false" />

        <Video id="video" translation="[0,0]" width="1920" height="1080" visible="false" />


        <Group id="guide" visible="false">
            <Rectangle width="1920" height="1080" color="0x0B0F14FF" />
            <Label id="gTitle" translation="[60,30]" width="1200" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
            <Label id="gClock" translation="[1400,38]" width="460" horizAlign="right" font="font:MediumSystemFont" color="0x8A97A6FF" />
            <Label id="gHint" translation="[60,92]" width="1800" font="font:SmallestSystemFont" color="0x8A97A6FF"
                   text="Left/Right: programmes   Up/Down: channels   OK: watch   Rewind/FF: page   Replay: jump to now   *: favorite   Back: close" />
            <Group id="gHead" />
            <Group id="gRowsG" />
            <Rectangle id="gNowLine" width="3" height="704" color="0xFF4D4DFF" visible="false" />
            <Rectangle translation="[0,892]" width="1920" height="188" color="0x141B24FF" />
            <Rectangle translation="[0,892]" width="1920" height="3" color="0x2563EBFF" />
            <Label id="gdChan" translation="[60,902]" width="900" font="font:SmallBoldSystemFont" color="0x60A5FAFF" />
            <Label id="gdTime" translation="[900,902]" width="960" horizAlign="right" font="font:SmallSystemFont" color="0xA9B6C6FF" />
            <Label id="gdTitle" translation="[60,934]" width="1800" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
            <Label id="gdDesc" translation="[60,978]" width="1800" height="92" wrap="true" font="font:SmallSystemFont" color="0xC8D1DCFF" />
        </Group>

        <Group id="overlay" visible="false">
            <Rectangle translation="[0,840]" width="1920" height="240" color="0x000000B8" />
            <Poster id="ovLogo" translation="[80,874]" width="88" height="48" visible="false" loadDisplayMode="scaleToFit" loadWidth="176" loadHeight="96" />
            <Label id="ovName" translation="[184,870]" width="1656" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
            <Label id="ovEpg" translation="[80,950]" width="1760" height="100" wrap="true" font="font:MediumSystemFont" color="0xE0E6EDFF" />
        </Group>

        <Group id="nerd" visible="false">
            <Rectangle translation="[40,40]" width="1100" height="780" color="0x000000D8" />
            <Label id="nerdText" translation="[64,56]" width="1052" height="750" wrap="true" lineSpacing="2"
                   font="font:SmallSystemFont" color="0xB8F7C8FF" />
        </Group>

        <Label id="idxStatus" translation="[1100,48]" width="760" horizAlign="right" visible="false" font="font:SmallSystemFont" color="0x8A97A6FF" />
        <Label id="status" translation="[620,940]" width="1240" visible="false" color="0xFFD166FF" />

        <Timer id="epgTimer" duration="0.35" repeat="false" />
        <Timer id="ovTimer" duration="5" repeat="false" />
        <Timer id="statusTimer" duration="3" repeat="false" />
        <Timer id="nerdTimer" duration="1" repeat="true" />
    </children>
</component>
